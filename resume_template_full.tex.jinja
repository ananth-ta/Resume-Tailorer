%-------------------------
% Resume in Latex
% Author : Jake Gutierrez
% Based off of: https://github.com/sb2nov/resume
% License : MIT
%
% LONG-FORM variant of resume_template.tex.jinja: no page budget. Prints every
% field the one-page template suppresses (coursework_extra, education details,
% project org/url, certification issuer/expiry, test-score values). Pair it
% with a selection listing every bank ID; render_resume.py's multi-page
% warning is expected and can be ignored.
%
% Jinja2-templated variant. Rendered by render_resume.py using alternate
% delimiters so LaTeX's own braces/percent signs never collide with Jinja.
% See build_jinja_env() in render_resume.py for the exact delimiter set.
% All content comes from experience_bank.json at render time. No personal
% data is hardcoded in this file.
%------------------------

% Deliberately letterpaper, not legalpaper: legal paper was tried earlier
% to fit more content on one page, but it breaks ATS parsing compliance.
% Do not change this without re-confirming ATS impact.
%
% 10pt (not Jake's original 11pt): at 11pt the text column fits ~110 chars
% per line vs ~126 in the reference resume, so long bullets wrapped an extra
% line each and a standard selection spilled onto page 2. 10pt restores that
% density on letter paper. Raising it back to 11pt costs roughly 3-4 lines.
\documentclass[letterpaper,11pt]{article}

\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}
\input{glyphtounicode}


%----------FONT OPTIONS----------
% sans-serif
% \usepackage[sfdefault]{FiraSans}
% \usepackage[sfdefault]{roboto}
% \usepackage[sfdefault]{noto-sans}
% \usepackage[default]{sourcesanspro}

% serif
% \usepackage{CormorantGaramond}
% \usepackage{charter}


\pagestyle{fancy}
\fancyhf{} % clear all header and footer fields
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Adjust margins
\addtolength{\oddsidemargin}{-0.5in}
\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1in}
\addtolength{\topmargin}{-.5in}
\addtolength{\textheight}{1.0in}

\urlstyle{same}

\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Sections formatting
\titleformat{\section}{
  \vspace{-4pt}\scshape\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{-5pt}]

% Ensure that generate pdf is machine readable/ATS parsable
\pdfgentounicode=1

%-------------------------
% Custom commands
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

% Long-form project heading: the left column wraps (tabularx X) so long titles
% and org lines never collide with the right column; tech gets its own row.
\newcommand{\resumeProjectHeadingFull}[5]{
  \vspace{-2pt}\item
    \begin{tabularx}{0.97\textwidth}[t]{@{}X@{\hspace{1.5em}}r@{}}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \small #4 \\
      \multicolumn{2}{@{}p{0.97\textwidth}@{}}{\small\textbf{Tech:} #5} \\
    \end{tabularx}\vspace{-7pt}
}

\newcommand{\resumeSubheadingExt}[6]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \textit{\small #4} \\
      \multicolumn{2}{p{0.97\textwidth}}{
        {\small#5} \hfill {\small#6}
      } \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubSubheading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \textit{\small#1} & \textit{\small #2} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & #2 \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubItem}[1]{\resumeItem{#1}\vspace{-4pt}}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

%-------------------------------------------
%%%%%%  RESUME STARTS HERE  %%%%%%%%%%%%%%%%%%%%%%%%%%%%


\begin{document}

((= Header: every field comes from profile.*; profile.legal_name is never referenced. =))
%----------HEADING----------
\begin{center}
    \textbf{\Huge \scshape ((( profile.preferred_name | tex )))} \\ \vspace{1pt}
    \small ((( profile.location | tex ))) $|$ ((( profile.phone | tex ))) $|$
    \href{mailto:((( profile.email | url )))}{\underline{((( profile.email | tex )))}} $|$
    \href{https://((( profile.linkedin | url )))}{\underline{((( profile.linkedin | tex )))}} $|$
    \href{https://((( profile.github | url )))}{\underline{((( profile.github | tex )))}}
\end{center}


((* if education *))
%-----------EDUCATION-----------
\section{Education}
  \resumeSubHeadingListStart
((* for e in education *))
    \resumeSubheading
      {((( e.institution | tex )))}{\textbf{((( e.location | default('', true) | tex )))}}
      {((( e.degree | tex )))}{((( e.start | mmy ))) -- ((( e.end | mmy )))}
      \resumeItemListStart
((* if e.gpa *))
        \resumeItem{GPA: ((( e.gpa | tex )))}
((* endif *))
((* if e.coursework *))
        \resumeItem{((( e.coursework | tex )))}
((* endif *))
((* if e.coursework_extra is defined and e.coursework_extra *))
        \resumeItem{((( e.coursework_extra | tex )))}
((* endif *))
((* for d in (e.details if e.details is defined else []) *))
        \resumeItem{((( (d.text if d is mapping else d) | tex )))}
((* endfor *))
      \resumeItemListEnd
((* endfor *))
  \resumeSubHeadingListEnd
((* endif *))


((* if experience *))
%-----------EXPERIENCE-----------
\section{Experience}
  \resumeSubHeadingListStart
((* for e in experience *))
    \resumeSubheading
      {((( e.title | tex )))}{((( e.start | mmy ))) -- ((( e.end | mmy )))}
      {((( e.org | tex )))}{((( e.location | default('', true) | tex )))}
      \resumeItemListStart
((* for b in e.bullets *))
        \resumeItem{((( b.text | tex )))}
((* endfor *))
      \resumeItemListEnd
((* endfor *))
  \resumeSubHeadingListEnd
((* endif *))


((* if projects *))
%-----------PROJECTS-----------
\section{Projects}
    \resumeSubHeadingListStart
((* for e in projects *))
    \resumeProjectHeadingFull
      {((( e.title | tex )))}{((( e.start | mmy ))) -- ((( e.end | mmy )))}
      {((( e.org | tex )))}{((* if e.url is defined and e.url *))\href{https://((( e.url | url )))}{\underline{((( e.url | url | tex )))}}((* endif *))}
      {((( e.tech | default('', true) | tex )))}
          \resumeItemListStart
((* for b in e.bullets *))
            \resumeItem{((( b.text | tex )))}
((* endfor *))
          \resumeItemListEnd
((* endfor *))
    \resumeSubHeadingListEnd
((* endif *))


((* if activities *))
%-----------ACTIVITIES-----------
\section{Activities}
    \resumeSubHeadingListStart
((* for e in activities *))
    \resumeSubheading
      {((( e.org | tex )))}{((( e.start | mmy ))) -- ((( e.end | mmy )))}
      {((( e.title | tex )))}{}
          \resumeItemListStart
((* for b in e.bullets *))
            \resumeItem{((( b.text | tex )))}
((* endfor *))
          \resumeItemListEnd
((* endfor *))
    \resumeSubHeadingListEnd
((* endif *))


((= Test scores are stored as skills whose tags are ['test score', <date>, <scores>...]. =))
((* set tech_skills = skills | rejectattr('category', 'equalto', 'Test Scores') | list *))
((* set test_scores = skills | selectattr('category', 'equalto', 'Test Scores') | list *))
((* if tech_skills *))
((* set categories = [] *))
((* for s in tech_skills *))((* if s.category not in categories *))((* set _ = categories.append(s.category) *))((* endif *))((* endfor *))
%-----------PROGRAMMING SKILLS-----------
\section{Technical Skills}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
((* for c in categories *))
     \textbf{((( c | tex )))}{: ((( tech_skills | selectattr('category', 'equalto', c) | map(attribute='name') | join(', ') | tex )))} \\
((* endfor *))
    }}
 \end{itemize}
((* endif *))


((* if certifications *))
%---------------CERTIFICATIONS------------
\section{Certifications}
  \resumeSubHeadingListStart
((* for c in certifications *))
    \resumeSubheading
      {((( c.name | tex )))}{((( c.date | mmy )))((* if c.expires *)) -- ((( c.expires | mmy )))((* endif *))}
      {((( c.issuer | default('', true) | tex )))}{((* if c.credential_id *))((* if c.credential_id | is_url *))\href{https://((( c.credential_id | url )))}{\underline{((( c.credential_id | url | tex )))}}((* else *))ID: ((( c.credential_id | tex )))((* endif *))((* endif *))}
    \vspace{4pt}
((* endfor *))
  \resumeSubHeadingListEnd
((* endif *))


((* if test_scores *))
%---------------TEST SCORES------------
\section{Test Scores}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
((* for s in test_scores *))
((* set scores = s.tags[2:] *))
     \textbf{((( s.name | tex )))}{: ((( scores[0] | tex )))((* if scores | length > 1 *)) ((( '(' ~ (scores[1:] | join(', ') | tex) ~ ')' )))((* endif *))} \hfill \textit{((( s.tags[1] | tex )))} \\
((* endfor *))
    }}
 \end{itemize}
((* endif *))


%-------------------------------------------
\end{document}
